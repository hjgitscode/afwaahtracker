{
  "name": "afwaah-tracker-server",
  "version": "1.0.0",
  "private": true,
  "description": "AfwaahTracker REST API (Node.js + Express + node-oracledb)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=app.js --watch-path=claims --watch-path=config --watch-path=controllers --watch-path=db --watch-path=ingestion --watch-path=middleware --watch-path=routes --watch-path=services --watch-path=web-search server.js",
    "ingest": "node scripts/runIngestion.js",
    "db:install": "node scripts/installDb.js",
    "db:migrate": "node scripts/migrateDb.js",
    "db:check": "node scripts/checkDb.js",
    "repair": "node scripts/repairLive.js",
    "investigate": "node scripts/investigate.js",
    "db:prepare": "node scripts/prepareDb.js",
    "start:production": "node scripts/prepareDb.js && node server.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "node-cron": "^4.6.0",
    "oracledb": "^7.0.1",
    "rss-parser": "^3.13.0"
  }
}
