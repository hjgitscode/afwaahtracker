# ---------------------------------------------------------------
# AfwaahTracker server configuration  (copy to server/.env)
# ---------------------------------------------------------------

# Oracle connection (node-oracledb Thin mode - no Instant Client needed)
DB_USER=afwaah
DB_PASSWORD=afwaah
# Oracle Database Free:  localhost:1521/FREEPDB1
# Oracle XE 21c:         localhost:1521/XEPDB1
DB_CONNECT_STRING=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=8

# API
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Background monitoring feeds (GDELT, Hacker News, RSS/Atom)
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_RUN_ON_START=true
INGESTION_TIMEOUT_MS=15000

# Deterministic rule-based claim matching thresholds (0-100)
MATCH_STRONG_THRESHOLD=75
MATCH_CANDIDATE_THRESHOLD=55

# Live web investigation (Tavily Search API)
# Create a free Tavily account, copy the API key from the Tavily dashboard and
# paste it after the "=". The key stays on the server: it is never sent to the
# browser or stored in Oracle. Leave it empty to use stored sources and the
# background feeds only.
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=tavily
# Results requested per investigation (one basic search request, max 20)
WEB_SEARCH_MAX_RESULTS=20

# Public page fetching limits
WEB_FETCH_TIMEOUT_MS=9000
WEB_FETCH_MAX_BYTES=1500000
WEB_FETCH_CONCURRENCY=5
WEB_FETCH_RESPECT_ROBOTS=true
