# ---------------------------------------------------------------
# AfwaahTracker server configuration  (copy to server/.env)
# ---------------------------------------------------------------

# Oracle connection (node-oracledb Thin mode - no Instant Client needed)
DB_USER=afwaah
DB_PASSWORD=afwaah
# Oracle Database Free:  localhost:1521/FREEPDB1
# Oracle XE 21c:         localhost:1521/XEPDB1
DB_CONNECT_STRING=localhost:1521/FREEPDB1
DB_POOL_MIN=1
DB_POOL_MAX=8

# API
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Automated ingestion
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_RUN_ON_START=true
INGESTION_TIMEOUT_MS=15000

# Deterministic rule-based claim matching thresholds (0-100)
MATCH_STRONG_THRESHOLD=75
MATCH_CANDIDATE_THRESHOLD=55
