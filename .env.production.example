# ---------------------------------------------------------------
# AfwaahTracker production settings
# Copy to .env.production on the server, fill in the values and keep it private:
#     cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production. None of these values reach the browser.
# ---------------------------------------------------------------

# Public domain name (DNS A record must point at this server)
DOMAIN=afwaah.example.com

# Oracle: SYS/SYSTEM password and the application user (created on first start)
ORACLE_PASSWORD=change-me-long-random-oracle-admin-password
DB_USER=afwaah
DB_PASSWORD=change-me-long-random-app-password

# Live web investigation (Tavily). Empty = stored data and feeds only.
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_MAX_RESULTS=20

# Cross-origin browser access. Leave empty: the site and /api share one origin.
CORS_ORIGINS=

# Write/admin API (create/edit/delete claims and sources, feed sync).
# Empty = disabled on the public site. Set a long random value to allow
# requests with "Authorization: Bearer <ADMIN_TOKEN>".
ADMIN_TOKEN=

# Rate limits (per visitor IP unless stated)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
INVESTIGATE_RATE_WINDOW_MINUTES=60
INVESTIGATE_RATE_MAX=10
# Site-wide cap on new web searches per day (0 = no cap)
INVESTIGATE_DAILY_LIMIT=100

# Background feeds (GDELT, Hacker News, RSS)
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=60
INGESTION_RUN_ON_START=false
INGESTION_TIMEOUT_MS=15000

# Public page fetching
WEB_FETCH_TIMEOUT_MS=9000
WEB_FETCH_MAX_BYTES=1500000
WEB_FETCH_CONCURRENCY=5
WEB_FETCH_RESPECT_ROBOTS=true

# Matching thresholds (keep the defaults)
MATCH_STRONG_THRESHOLD=75
MATCH_CANDIDATE_THRESHOLD=55
